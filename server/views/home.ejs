<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= settings.site_name || 'Instacertify' %> Info</title>
  <meta name="description" content="Official information pages from Instacertify." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #14201c;
      --muted: #4d5f57;
      --bg: #eef5f1;
      --accent: #0f6b4c;
      --line: rgba(20, 32, 28, 0.12);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Source Sans 3", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 10% 0%, rgba(15, 107, 76, 0.16), transparent 40%),
        radial-gradient(circle at 90% 20%, rgba(196, 145, 58, 0.18), transparent 35%),
        linear-gradient(180deg, #f7faf8 0%, var(--bg) 100%);
    }
    main {
      width: min(920px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 4rem 0 5rem;
    }
    h1 {
      font-family: Fraunces, Georgia, serif;
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      line-height: 1.05;
      margin: 0 0 0.75rem;
    }
    p { color: var(--muted); max-width: 42ch; margin: 0 0 2rem; }
    ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem; }
    a {
      display: block;
      text-decoration: none;
      color: inherit;
      padding: 1rem 0;
      border-top: 1px solid var(--line);
      font-weight: 600;
    }
    a:hover { color: var(--accent); }
    .empty { border-top: 1px solid var(--line); padding-top: 1rem; }
  </style>
</head>
<body>
  <main>
    <h1><%= settings.site_name || 'Instacertify' %></h1>
    <p>Browse published information pages for products, certifications, and guides.</p>
    <% if (!pages.length) { %>
      <p class="empty">No published pages yet. Create one in the admin.</p>
    <% } else { %>
      <ul>
        <% pages.forEach(function(page) { %>
          <li><a href="/<%= page.slug %>"><%= page.title %></a></li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>
