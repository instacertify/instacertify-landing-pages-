<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #101010;
      --paper: #f2f0ea;
      --accent: #e23d2c;
      --muted: #4a4a46;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", sans-serif;
      color: var(--ink);
      background: var(--paper);
    }
    .preview-banner {
      background: var(--ink);
      color: #fff;
      text-align: center;
      padding: 0.55rem;
      font-size: 0.85rem;
    }
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-rows: 1fr auto;
      position: relative;
      overflow: hidden;
      color: #fff;
      background:
        linear-gradient(120deg, rgba(0,0,0,0.72), rgba(0,0,0,0.35)),
        <% if (page.heroImage) { %>url("<%= page.heroImage %>") center/cover no-repeat,<% } %>
        linear-gradient(160deg, #1a1a1a, #3a2a22 50%, #111);
    }
    .hero-copy {
      padding: clamp(1.5rem, 5vw, 4rem);
      align-self: end;
      max-width: 920px;
    }
    .brand {
      font-family: "Archivo Black", sans-serif;
      font-size: clamp(3rem, 10vw, 7rem);
      line-height: 0.9;
      letter-spacing: -0.04em;
      margin: 0 0 1rem;
      text-transform: uppercase;
      animation: slam 700ms cubic-bezier(.2,.8,.2,1) both;
    }
    .headline {
      font-size: clamp(1.2rem, 2.4vw, 1.7rem);
      font-weight: 700;
      max-width: 24ch;
      margin: 0 0 0.8rem;
      animation: slam 700ms 80ms cubic-bezier(.2,.8,.2,1) both;
    }
    .sub {
      max-width: 40ch;
      color: rgba(255,255,255,0.85);
      margin: 0 0 1.5rem;
      animation: slam 700ms 140ms cubic-bezier(.2,.8,.2,1) both;
    }
    .cta {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      padding: 1rem 1.4rem;
      animation: slam 700ms 200ms cubic-bezier(.2,.8,.2,1) both;
    }
    .cta:hover { filter: brightness(1.08); }
    .hero-stripe {
      height: 10px;
      background: repeating-linear-gradient(90deg, var(--accent) 0 40px, #111 40px 80px);
      animation: slide 12s linear infinite;
    }
    section {
      width: min(880px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 4rem 0;
    }
    section h2 {
      font-family: "Archivo Black", sans-serif;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      margin: 0 0 0.7rem;
    }
    section p, .body-content { color: var(--muted); line-height: 1.65; max-width: 60ch; }
    .section-block + .section-block { margin-top: 2.5rem; }
    footer { padding: 2rem; border-top: 4px solid var(--ink); font-weight: 600; }
    @keyframes slam {
      from { opacity: 0; transform: translateY(28px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes slide {
      from { background-position: 0 0; }
      to { background-position: 160px 0; }
    }
  </style>
</head>
<body>
  <%- include('../partials/body-scripts') %>
  <% if (isPreview) { %><div class="preview-banner">Preview — not indexed</div><% } %>
  <header class="hero">
    <div class="hero-copy">
      <h1 class="brand"><%= page.brandName %></h1>
      <% if (page.headline) { %><p class="headline"><%= page.headline %></p><% } %>
      <% if (page.subheadline) { %><p class="sub"><%= page.subheadline %></p><% } %>
      <% if (page.ctaLabel && page.ctaUrl) { %>
        <a class="cta" href="<%= page.ctaUrl %>"><%= page.ctaLabel %></a>
      <% } %>
    </div>
    <div class="hero-stripe" aria-hidden="true"></div>
  </header>

  <% if (page.sections && page.sections.length) { %>
  <section>
    <% page.sections.forEach(function(block) { %>
      <div class="section-block">
        <% if (block.heading) { %><h2><%= block.heading %></h2><% } %>
        <% if (block.text) { %><p><%= block.text %></p><% } %>
      </div>
    <% }) %>
  </section>
  <% } %>

  <% if (page.bodyHtml) { %>
  <section class="body-content"><%- page.bodyHtml %></section>
  <% } %>

  <footer>© <%= new Date().getFullYear() %> <%= page.brandName %></footer>
</body>
</html>
